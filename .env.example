# Server
PORT=3000
HOST=0.0.0.0

# Logging: error | warn | info | debug  (default info)
# LOG_LEVEL=info
# Force ANSI colors in docker logs (auto|always|never). Docker has no TTY so use always.
# LOG_COLOR=always

# Admin login (required in practice — a random password is generated and
# printed to the log if ADMIN_PASSWORD is left empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Session signing secret (auto-generated and persisted if empty)
# SESSION_SECRET=some-long-random-string
# SESSION_TTL_MS=86400000

# Where channels/keys/tokens/settings are stored (JSON file)
# DATA_DIR=./data

# Global fallback outbound proxy for channels without their own proxy.
# Per-channel proxies configured in the dashboard take precedence.
# OUTBOUND_PROXY=http://127.0.0.1:7890

# Number of reverse-proxy hops to trust (nginx/traefik) so client IPs for
# login rate limiting come from X-Forwarded-For. Use the hop count (usually 1),
# never more than your real proxy depth — extra hops make the IP spoofable.
# TRUST_PROXY=1

# Max request body size for /v1 in bytes (default 25 MB)
# BODY_LIMIT_BYTES=26214400
